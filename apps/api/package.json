{
  "name": "@namma-kasa/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node-pg-migrate -m migrations up",
    "migrate:down": "node-pg-migrate -m migrations down",
    "seed": "tsx scripts/seed.ts",
    "openapi": "tsx src/openapi/emit.ts",
    "simulate-trip": "tsx scripts/simulate-trip.ts",
    "load-test": "tsx scripts/load-test.ts",
    "routes": "tsx scripts/list-routes.ts",
    "contracts:coverage": "tsx scripts/check-coverage.ts",
    "coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.include='src/**'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1096.0",
    "@aws-sdk/s3-request-presigner": "^3.1096.0",
    "@namma-kasa/shared": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-ws": "^10.4.15",
    "@nestjs/websockets": "^10.4.15",
    "argon2": "^0.41.1",
    "firebase-admin": "^14.2.0",
    "google-auth-library": "^10.9.1",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.27.5",
    "mqtt": "^5.10.3",
    "nestjs-pino": "^4.2.0",
    "pg": "^8.13.1",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.18.0",
    "zod": "^3.24.0",
    "zod-openapi": "^4.2.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "2.1.9",
    "node-pg-migrate": "^7.9.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.0",
    "vitest": "^2.1.8"
  }
}
