# Local infrastructure (docker-compose.yml)
POSTGRES_USER=nammakasa
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=nammakasa
# 5433 by default: 5432 is commonly taken by a host Postgres install.
POSTGRES_PORT=5433

REDIS_PORT=6379

MQTT_PORT=1883
EMQX_DASHBOARD_PORT=18083
EMQX_DASHBOARD_PASSWORD=devpassword

MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# API (apps/api)
DATABASE_URL=postgres://nammakasa:devpassword@localhost:5433/nammakasa
REDIS_URL=redis://localhost:6379
MQTT_URL=mqtt://localhost:1883
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=namma-kasa-media
JWT_SECRET=dev-only-change-me
# console | msg91 — console prints OTPs to the API log for local dev
OTP_SENDER=console
